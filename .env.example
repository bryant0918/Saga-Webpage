# Stripe API Keys
# Get these from https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_your_test_secret_key_here
STRIPE_PUBLISHABLE_KEY=pk_test_your_test_publishable_key_here

# Stripe Webhook Secret
# Get this from https://dashboard.stripe.com/webhooks after creating webhook endpoint
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here

# Redis Connection URL
# For Upstash Redis (recommended): https://console.upstash.com/
# Format: redis://default:password@host:port
REDIS_URL=redis://default:your_redis_password@your-redis-host.upstash.io:6379

# Production Note:
# For production, use sk_live_... and pk_live_... keys from Stripe
# and update the webhook endpoint URL in Stripe dashboard

# Public Frontend Configuration
# These values are exposed to client-side scripts via /api/public-config.js.
FS_APP_KEY=<your_familysearch_app_key_here>
# beta or production
FS_ENVIRONMENT=beta
FS_BASE_URL=https://identbeta.familysearch.org
FS_TOKEN_URL=https://identbeta.familysearch.org/cis-web/oauth2/v3/token
FS_API_BASE_URL=https://apibeta.familysearch.org
GETFORM_ENDPOINT=https://getform.io/f/bdrgewgb
# Optional override for Python API base URL.
# If omitted, dev uses http://localhost:5000 and non-dev uses production.
TREE_BACKEND_BASE_URL=http://localhost:5000

# Backend order ledger (required for the proof/payment flow)
# Shared secret the Stripe webhook uses to tell the Python backend an order was
# paid. Must match INTERNAL_API_SECRET in the backend's .env exactly.
# Generate with: openssl rand -hex 32
INTERNAL_API_SECRET=

# Comma-separated FamilySearch person IDs allowed to reach /admin.
# Leave blank to use the built-in defaults.
ADMIN_PERSON_IDS=

# Public base URL, used for Stripe success/cancel redirects.
PUBLIC_BASE_URL=http://localhost:3000

# ---------- Stripe price IDs (sandbox / test mode only) ----------
# Price IDs are per-mode objects. Copying products into a Stripe sandbox creates
# NEW prices with NEW IDs, so the live IDs baked into api/stripe-pricing.js do
# not exist there and checkout fails with "No such price".
#
# Leave these blank in production to use the live defaults. To test locally
# against a sandbox, set STRIPE_SECRET_KEY to the sandbox key AND fill these in
# with the sandbox price IDs (Stripe dashboard -> Product catalogue -> each
# product -> the price's API ID).
STRIPE_PRICE_ANCESTRY_4=
STRIPE_PRICE_ANCESTRY_5=
STRIPE_PRICE_DESCENDANT_3=
STRIPE_PRICE_DESCENDANT_4=

# Local webhook testing:
#   stripe listen --forward-to localhost:3000/api/stripe-webhook
# It prints its own whsec_... - put that in STRIPE_WEBHOOK_SECRET above while
# testing locally. Without a tunnel, Stripe delivers only to the endpoint
# registered in the dashboard (production), so a local order never unlocks.
